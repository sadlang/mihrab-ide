{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#*", "*#"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "#*", "close": " *#", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": {
    "pattern": "(-?[\\d٠-٩]+(\\.[\\d٠-٩]+)?)|([\\p{L}_][\\p{L}\\p{Nd}_]*)",
    "flags": "u"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*#\\*(?!.*\\*#).*$",
      "action": { "indent": "none", "appendText": " " }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
