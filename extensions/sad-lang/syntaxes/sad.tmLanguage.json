        {
          "name": "storage.modifier.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])(?:ثابت|ساكن|محمي|خاص|عام)(?![\\p{L}\\p{Nd}_])"
        },
        {
          "name": "keyword.operator.word.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])(?:مؤكدة|مؤكد|ليس|أو|و)(?![\\p{L}\\p{Nd}_])"
        },
        {
          "name": "constant.language.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])(?:لاشيء|صحيح|خطأ)(?![\\p{L}\\p{Nd}_])"
        },
        {
          "name": "keyword.other.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])(?:نهاية_استخدام|غير_متزامنة|غير_متزامن|نهاية_فضاء|باستخدام|امتداد|رئيسية|متطاير|اختبر|انتظر|خاصية|لامدا|ماكرو|واجهة|يتطلب|أجّل|أطلق|أنتج|اجّل|احصل|اختر|اطلق|اعرض|اعطِ|انشر|ترجع|حالة|عامل|عيّن|فضاء|قالب|محكم|مولد|نفّذ|يضمن|أجل|إلى|اجل|الى|حيث|سمة|عقد|عين|نفذ|نوع|هدم|ثم)(?![\\p{L}\\p{Nd}_])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])(?:مصفوفة|خريطة|منطقي|عشري|فراغ|رقم|عدم|أي|نص)(?![\\p{L}\\p{Nd}_])"
        }
