    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sad",
          "match": "!=|%=|\\&\\&|\\(\\)|\\*\\*|\\*=|\\+\\+|\\+=|\\-\\-|\\-=|\\.\\.|//|/=|<<|<=|==|>=|>>|\\[\\]|\\|\\||؟\\.|؟؟|!|%|\\&|\\*|\\+|\\-|\\.|/|:|<|=|>|\\^|\\||\\~|؟"
        }
      ]
    }
