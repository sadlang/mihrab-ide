      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.sad",
          "begin": "(?<![\\p{L}\\p{Nd}_])r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.interpolated.sad",
          "begin": "(?<![\\p{L}\\p{Nd}_])f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sad",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.sad",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#keywords"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#types"
                },
                {
                  "include": "#operators"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.sad",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sad",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "lifetimes": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.sad",
          "match": "'[\\p{L}\\p{Nd}_]+"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])0[xX][0-9a-fA-F_]+"
        },
        {
          "name": "constant.numeric.binary.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])0[bB][01_]+"
        },
        {
          "name": "constant.numeric.octal.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])0[oO][0-7_]+"
        },
        {
          "name": "constant.numeric.decimal.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])[\\d٠-٩](?:[\\d٠-٩]|_)*(?:\\.[\\d٠-٩](?:[\\d٠-٩]|_)*)?(?:[eE][+\\-]?[\\d٠-٩]+)?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])(?:افتراضي|أخيراً|استورد|الأساس|أخيرا|استمر|بينما|خارجي|عندما|متغير|نهاية|ارجع|ارمي|امسك|توقف|جديد|حاول|صدّر|طابق|مجرد|وإلا|والا|إذا|اذا|صدر|لكل|هذا|في|كـ|من)(?![\\p{L}\\p{Nd}_])"
        },
        {
          "name": "storage.type.sad",
          "match": "(?<![\\p{L}\\p{Nd}_])(?:تعداد|باني|بنية|دالة|صنف|يرث)(?![\\p{L}\\p{Nd}_])"
