{
  "$schema": "vscode://schemas/vscode-extensions",
  "name": "mihrab-nebras",
  "displayName": "نِبراس — ذكاء ص في محراب",
  "description": "تكامل نِبراس (طبقة الذكاء الرسميّة للغة ص) داخل محراب (م2ب): شرح تحديد، ودردشة، وإكمال سطريّ — عبر عقد nebras-protocol (JSON-RPC 2.0 على stdio) مع خادم نِبراس المقيم. عربيّ أوّلًا، تحت آلة الأذونات (ق5/ق12).",
  "version": "0.1.0",
  "publisher": "sadlang",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Machine Learning"],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:sad"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mihrab.nebras.explainSelection",
        "title": "نِبراس: اشرح التحديد",
        "shortTitle": "اشرح التحديد",
        "category": "نِبراس"
      },
      {
        "command": "mihrab.nebras.openChat",
        "title": "نِبراس: افتح الدردشة",
        "shortTitle": "دردشة نِبراس",
        "category": "نِبراس"
      },
      {
        "command": "mihrab.nebras.restart",
        "title": "نِبراس: أعِد تشغيل الخادم",
        "shortTitle": "أعِد تشغيل نِبراس",
        "category": "نِبراس"
      },
      {
        "command": "mihrab.nebras.toggleInlineCompletion",
        "title": "نِبراس: بدّل الإكمال السطريّ",
        "shortTitle": "بدّل الإكمال السطريّ",
        "category": "نِبراس"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mihrab.nebras.explainSelection",
          "when": "editorHasSelection && editorLangId == sad",
          "group": "nebras@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mihrab.nebras.explainSelection",
        "key": "ctrl+alt+e",
        "when": "editorTextFocus && editorLangId == sad"
      }
    ],
    "configuration": {
      "title": "نِبراس",
      "properties": {
        "mihrab.nebras.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "مسار مطلق لنقطة دخول خادم نِبراس (`packages/cli/dist/index.js`). فارغ ⇒ يُبحَث عن الخادم المدمج مع الامتداد ثمّ متغيّر البيئة `NEBRAS_CLI`."
        },
        "mihrab.nebras.nodePath": {
          "type": "string",
          "default": "node",
          "description": "مسار مُفسِّر Node لتشغيل خادم نِبراس (اسم على PATH أو مسار مطلق)."
        },
        "mihrab.nebras.proxyUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "عنوان وسيط نِبراس (`NEBRAS_PROXY_URL`) الذي يحمل مفاتيح Claude والاستحقاق. فارغ ⇒ يعمل الخادم بمزوّد وهميّ (Mock) للتجربة دون سحابة."
        },
        "mihrab.nebras.permissionMode": {
          "type": "string",
          "enum": ["اقتراح", "آمن", "طيّار"],
          "default": "آمن",
          "markdownEnumDescriptions": [
            "يقترح التغييرات فقط دون تطبيق.",
            "يطلب موافقتك قبل كلّ كتابة/تشغيل (الافتراض).",
            "يطبّق آليًّا ضمن حدود صلبة (مجلّد العمل، لا مدمّرة، لا خروج شبكيّ)."
          ],
          "description": "وضع آلة أذونات نِبراس (ق5/ق12)."
        },
        "mihrab.nebras.locale": {
          "type": "string",
          "enum": ["ar", "en"],
          "default": "ar",
          "description": "لغة تفاعل نِبراس (ق7: عربيّ أوّلًا)."
        },
        "mihrab.nebras.inlineCompletion": {
          "type": "boolean",
          "default": false,
          "description": "تفعيل الإكمال السطريّ عبر نِبراس (يستهلك توكنات؛ مطفأ افتراضًا)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sadlang/mihrab-ide.git"
  }
}
