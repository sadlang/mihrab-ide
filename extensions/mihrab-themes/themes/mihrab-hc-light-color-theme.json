  "tokenColors": [
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#101418"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#101418"
      }
    },
    {
      "scope": "comment",
      "settings": {
        "foreground": "#4A5560"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#6B4400"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "variable.other.enummember",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent"
      ],
      "settings": {
        "foreground": "#99270A"
      }
    },
    {
      "scope": "constant.regexp",
      "settings": {
        "foreground": "#33520C"
      }
