{
  "$schema": "vscode://schemas/color-theme",
  "name": "محراب الفاتحة عالية التباين",
  "type": "hcLight",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#101418",
    "contrastBorder": "#00564C",
    "contrastActiveBorder": "#6B4400",
    "focusBorder": "#6B4400",
    "foreground": "#101418",
    "editorLineNumber.foreground": "#4A5560",
    "editorLineNumber.activeForeground": "#101418",
    "editor.lineHighlightBorder": "#00564C",
    "editor.selectionBackground": "#CFE6E0",
    "editor.selectionForeground": "#101418",
    "editorCursor.foreground": "#6B4400",
    "editorWhitespace.foreground": "#8A9499",
    "editorIndentGuide.background1": "#8A9499",
    "editorIndentGuide.activeBackground1": "#00564C",
    "editorBracketMatch.background": "#FFFFFF",
    "editorBracketMatch.border": "#6B4400",
    "titleBar.activeBackground": "#FFFFFF",
    "titleBar.activeForeground": "#101418",
    "titleBar.inactiveBackground": "#FFFFFF",
    "titleBar.inactiveForeground": "#4A5560",
    "activityBar.background": "#FFFFFF",
    "activityBar.foreground": "#101418",
    "activityBar.inactiveForeground": "#4A5560",
    "activityBar.activeBorder": "#6B4400",
    "activityBarBadge.background": "#6B4400",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#FFFFFF",
    "sideBar.foreground": "#101418",
    "sideBarSectionHeader.background": "#F2F2F2",
    "sideBarTitle.foreground": "#101418",
    "statusBar.background": "#FFFFFF",
    "statusBar.foreground": "#101418",
    "statusBar.border": "#00564C",
    "statusBar.noFolderBackground": "#FFFFFF",
    "statusBar.debuggingBackground": "#FFFFFF",
    "tab.activeBackground": "#FFFFFF",
    "tab.inactiveBackground": "#FFFFFF",
    "tab.activeForeground": "#101418",
    "tab.inactiveForeground": "#4A5560",
    "tab.activeBorderTop": "#6B4400",
    "tab.border": "#00564C",
    "editorGroupHeader.tabsBackground": "#FFFFFF",
    "panel.background": "#FFFFFF",
    "panel.border": "#00564C",
    "panelTitle.activeForeground": "#101418",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#101418",
    "input.background": "#FFFFFF",
    "input.foreground": "#101418",
    "input.border": "#00564C",
    "dropdown.background": "#FFFFFF",
    "dropdown.border": "#00564C",
    "list.activeSelectionBackground": "#CFE6E0",
    "list.activeSelectionForeground": "#101418",
    "list.hoverBackground": "#F2F2F2",
    "list.highlightForeground": "#6B4400",
    "button.background": "#FFFFFF",
    "button.foreground": "#101418",
    "button.border": "#00564C",
    "button.hoverBackground": "#F2F2F2",
    "badge.background": "#6B4400",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#6B4400",
    "textLink.foreground": "#00457A",
    "textLink.activeForeground": "#6B4400",
    "scrollbarSlider.background": "#8A9499",
    "scrollbarSlider.hoverBackground": "#4A5560",
    "editorWidget.background": "#FFFFFF",
    "editorWidget.border": "#00564C",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.border": "#00564C",
    "editorSuggestWidget.selectedBackground": "#CFE6E0",
    "editorHoverWidget.background": "#FFFFFF",
    "editorHoverWidget.border": "#00564C",
    "peekViewEditor.background": "#FFFFFF"
  },
  "tokenColors": [
    {
      "name": "تعليق",
      "scope": [
        "comment",
        "comment.line.number-sign.sad",
        "comment.block.sad",
        "comment.line.documentation.sad",
        "comment.block.documentation.sad"
      ],
      "settings": {
        "foreground": "#4A5560",
        "fontStyle": "italic"
      }
    },
    {
      "name": "كلمة مفتاحيّة",
      "scope": [
        "keyword.control.sad",
        "keyword.control.directive.sad",
        "keyword.other.sad",
        "keyword.operator.word.sad",
        "storage.modifier.sad",
        "storage.modifier.lifetime.sad",
        "constant.language",
        "constant.language.sad"
      ],
      "settings": {
        "foreground": "#6B4400"
      }
    },
    {
      "name": "نوع",
      "scope": [
        "storage.type.sad",
        "support.type.sad"
      ],
      "settings": {
        "foreground": "#00457A"
      }
    },
    {
      "name": "عامل",
      "scope": [
        "keyword.operator.sad"
      ],
      "settings": {
        "foreground": "#37474F"
      }
    },
    {
      "name": "نصّ",
      "scope": [
        "string",
        "string.quoted.double.sad",
        "string.quoted.raw.sad",
        "string.quoted.interpolated.sad"
      ],
      "settings": {
        "foreground": "#33520C"
      }
    },
    {
      "name": "هروب",
      "scope": [
        "constant.character.escape.sad"
      ],
      "settings": {
        "foreground": "#99270A"
      }
    },
    {
      "name": "رقم",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal.sad",
        "constant.numeric.hex.sad",
        "constant.numeric.binary.sad",
        "constant.numeric.octal.sad"
      ],
      "settings": {
        "foreground": "#99270A"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#00564C",
    "method": "#00564C",
    "class": "#00457A",
    "struct": "#00457A",
    "enum": "#00457A",
    "interface": "#00457A",
    "type": "#00457A",
    "typeParameter": "#00457A",
    "namespace": "#00457A",
    "variable": "#101418",
    "parameter": "#101418",
    "property": "#101418",
    "enumMember": "#99270A",
    "keyword": "#6B4400",
    "number": "#99270A",
    "string": "#33520C",
    "comment": {
      "foreground": "#4A5560",
      "fontStyle": "italic"
    }
  }
}
