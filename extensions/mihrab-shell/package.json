{
  "$schema": "vscode://schemas/vscode-extensions",
  "name": "mihrab-shell",
  "displayName": "قشرة محراب",
  "description": "إعدادات قشرة محراب الافتراضيّة (اتّجاه RTL): الشريط الجانبي يمينًا، وتلوين أزواج الأقواس وأدلّتها لتوضيح البنية النحويّة في السياق العربيّ ثنائيّ الاتّجاه (BiDi). الطبقة 1 (إضافة محزومة) — لا رُقعة نواة.",
  "version": "0.1.0",
  "publisher": "sadlang",
  "license": "MIT",
  "engines": { "vscode": "*" },
  "categories": ["Other"],
  "contributes": {
    "configurationDefaults": {
      "workbench.sideBar.location": "right",
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": "active",
      "editor.guides.bracketPairsHorizontal": "active",
      "editor.matchBrackets": "always"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sadlang/mihrab-ide.git"
  }
}
