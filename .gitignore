# شجرة المنبع المُحضَّرة (تُستنسَخ وقت البناء — لا تُتعقَّب)
/.upstream/

# سلسلة الأدوات المعزولة (Node محمول، jq، node-gyp) — تُنزَّل عند البناء
/build/.toolchain/

# مخرجات البناء
/out/
/dist/
/*.vsix

# مخرَجات التشغيل الحيّ (L3): لقطات + ملفّ مستخدم/امتدادات معزول ينشئه launch.mjs
/tests/runtime/artifacts/

# سلسلة أدوات ص المدمجة (تُحقَن وقت البناء من sad-engines-dev — لا تُتعقَّب)
/extensions/mihrab-welcome/bin/
# [SAD-01] خادم ص اللغويّ المدمج (sad-lsp.exe يُحقَن وقت البناء في bin/ داخل sad-lang — لا يُتعقَّب)
/extensions/sad-lang/bin/
# [AR-01↔AR-02] خطّ media المحقون وقت البناء (كـbin/): media/ نفسه متعقَّب لوسائط الجولة،
# لكنّ الخطّ ثنائيّ يُحقَن (يقرؤه output-panel من extensionPath/media) فيُتجاهَل كي لا يُودَع
# لو أسقطه مطوّر هناك للتجربة المحلّيّة (يورَّد من ARABIC_FONT_SRC وقت البناء لا يُتعقَّب).
/extensions/mihrab-welcome/media/kawkab-mono.woff2

# [AR-02 · TY-01] وجوه الخطّ العربيّ: تُتجاهَل بالعموم كي لا يُودَع وجهٌ تجريبيٌّ سهوًا…
/patches/fonts/*.woff2
/patches/fonts/*.woff
/patches/fonts/*.ttf
/patches/fonts/*.otf
# …**إلّا** الوجهَ المعتمَد نفسَه. الخطّ صار **مورَّدًا فعلًا** لا موعودًا: بلا هذا الاستثناء
# كان محرابٌ يَعِد بخطٍّ عربيٍّ برمجيٍّ ويسلّم خطَّ نظام، والسقوطُ اللطيف يخفي ذلك عن السجلّ
# لا عن المستخدم — ومكدّس السقوط ليس أحاديَّ العرض للعربيّة، فتنكسر المسطراتُ صامتة.
# ونصُّ رخصة OFL مُودَعٌ بجانبه: إرفاقُه **إلزامٌ قانونيٌّ** عند إعادة التوزيع لا نظافةٌ اختياريّة.
!/patches/fonts/kawkab-mono.woff2

# اعتماديّات
node_modules/

# نظام/محرّر
.DS_Store
Thumbs.db
*.log
.vscode-test/

# Python bytecode (سكربتات الترقيع)
__pycache__/
*.pyc

# مخرَج مولّد موقع التوثيق — يُبنى في CI عند كلّ نشر، فلا يُلتزَم
site/public/
/tests/perf/.runs/
