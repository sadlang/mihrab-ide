+	test('fuzzyScore, word start after the Arabic definite article', function () {
+		// A script without letter case marks the second word of an identifier with the
+		// definite article instead of a capital, and users type the stem without it -
+		// just like `Btn` is typed for `SubmitButton`.
+		assertMatches('فضة', 'نصاب_الفضة', 'نصاب_ال^ف^ض^ة', fuzzyScore);
+		assertMatches('زكاة', 'حساب_الزكاة', 'حساب_ال^ز^ك^ا^ة', fuzzyScore);
+		assertMatches('الفضة', 'نصاب_الفضة', 'نصاب_^ا^ل^ف^ض^ة', fuzzyScore);
+		// ...but only where the article itself starts a segment: the trailing `ال` of
+		// `مالك` is part of the stem, so `لك` remains a weak match.
+		assertMatches('لك', 'مالك', undefined, fuzzyScore);
