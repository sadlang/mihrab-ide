+const enum ArabicCharCode {
+	Alef = 0x0627,
+	Lam = 0x0644,
+}
+
+/**
+ * Whether `index` starts a stem that follows the Arabic definite article (`ال`).
+ *
+ * Scripts without letter case have no `camelCase` boundary to mark where a word starts
+ * inside an identifier. Arabic instead attaches the definite article to the noun, so the
+ * article is exactly the marker that an upper-case letter is in `submitButton`: the stem
+ * of `نصاب_الفضة` starts at `فضة` the same way the second word of `SubmitButton` starts
+ * at `Button`, and users type the stem alone in both cases.
+ *
+ * The article only counts where it is itself at the start of a segment, so the trailing
+ * `ال` of a word such as `مالك` is not treated as one.
+ */
+function isAfterDefiniteArticleAtPos(value: string, index: number): boolean {
+	if (index < 2 || index >= value.length) {
+		return false;
+	}
+	if (value.charCodeAt(index - 2) !== ArabicCharCode.Alef || value.charCodeAt(index - 1) !== ArabicCharCode.Lam) {
+		return false;
+	}
+	return index === 2 || isSeparatorAtPos(value, index - 3) || isWhitespaceAtPos(value, index - 3);
+}
