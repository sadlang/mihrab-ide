 		wordSegmenterLocales: configurationService.getValue<string | string[]>('editor.wordSegmenterLocales'),
+		// Simple editors are text entry surfaces — commit messages, debug console input,
+		// breakpoint conditions, chat input. They are not code viewers, and users type prose
+		// in them in whatever script they write in.
+		//
+		// Two editor settings therefore have to reach them, and neither did:
+		//
+		// `editor.textDirection` — without it every simple editor is a left-to-right
+		// paragraph. Someone writing a commit message in Arabic, Hebrew, Persian or Urdu
+		// gets the caret on the wrong side, the text flush against the wrong edge, and
+		// trailing punctuation and digits resolved to the wrong end of the line. The main
+		// editor honours this setting; these boxes sit in the same window and do not.
+		//
+		// `editor.fontLigatures` — this maps to `font-feature-settings`, and turning it off
+		// disables `calt` (contextual alternates) along with `liga`. In Latin text that only
+		// costs a typographic nicety. In Arabic, Syriac and N'Ko, `calt` is how a font
+		// selects initial/medial/final letter forms: with it off the script stops joining and
+		// renders as disconnected letters. The setting is opt-in, so a user who enables it
+		// for the editor is silently denied it exactly where they type the most prose.
+		textDirection: configurationService.getValue<'auto' | 'ltr' | 'rtl'>('editor.textDirection'),
+		fontLigatures: configurationService.getValue<boolean | string>('editor.fontLigatures'),
 		accessibilitySupport: configurationService.getValue<'auto' | 'off' | 'on'>('editor.accessibilitySupport'),
 		cursorBlinking: configurationService.getValue<'blink' | 'smooth' | 'phase' | 'expand' | 'solid'>('editor.cursorBlinking'),
 		editContext: configurationService.getValue<boolean>('editor.editContext'),
