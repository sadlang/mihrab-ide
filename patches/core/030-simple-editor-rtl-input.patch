 	}
 
 	private _getEditorLineHeight(fontSize: number): number {
+		// `editor.lineHeight` is honoured here, with the same convention the main editor uses:
+		// `0` means "derive from the font size", a value below `MINIMUM_LINE_HEIGHT` is a
+		// multiplier, and anything larger is a pixel amount.
+		//
+		// The fixed `1.5` ratio below is a Latin assumption. Scripts that stack marks above
+		// and below the baseline need more: fully vocalised Arabic reaches roughly `1.9em` of
+		// ink, so at the shipped default the top of a fatha and the tail of a kasra are
+		// clipped. Users can already raise `editor.lineHeight` for the editor; this box was
+		// the one place that ignored them, and it is where they write the most prose.
+		const lineHeight = this.configurationService.getValue<number>('editor.lineHeight');
+		if (typeof lineHeight === 'number' && lineHeight > 0) {
+			return Math.round(lineHeight < MINIMUM_LINE_HEIGHT ? fontSize * lineHeight : lineHeight);
+		}
+
 		return Math.round(fontSize * 1.5);
 	}
 
