+	test('script-neutral ASCII does not make a word script-mixed', () => {
+		const options: UnicodeHighlighterOptions = {
+			allowedCodePoints: [],
+			allowedLocales: [],
+			ambiguousCharacters: true,
+			invisibleCharacters: true,
+			includeComments: true,
+			includeStrings: true,
+			nonBasicASCII: false
+		};
+
+		// `_` and the digit are identifier glue, not Latin: the word is single-script and
+		// none of its letters impersonate a Latin one.
+		assert.strictEqual((t('متغير_1', options) as { ambiguousCharacterCount: number }).ambiguousCharacterCount, 0);
+
+		// An ASCII *letter* next to a non-Latin one is genuine script mixing and is still
+		// reported: the Cyrillic `а` here is a homoglyph of `a`.
+		assert.strictEqual((t('examplа', options) as { ambiguousCharacterCount: number }).ambiguousCharacterCount, 1);
+
+		// The relaxation is confined to the ambiguous-character check. A bidi override in a
+		// word whose only ASCII is a digit is still reported - this is the Trojan Source
+		// defence, and it does not depend on the word's script.
+		assert.strictEqual((t('اسم‮1', options) as { invisibleCharacterCount: number }).invisibleCharacterCount, 1);
+	});
