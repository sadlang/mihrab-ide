+		const next = current === 'rtl' ? 'auto' : 'rtl';
+		await configurationService.updateValue('editor.textDirection', next, ConfigurationTarget.USER);
+		alert(next === 'rtl'
+			? nls.localize('toggleTextDirection.rtl', "The editor now lays out its text right-to-left")
+			: nls.localize('toggleTextDirection.auto', "The editor now follows the direction of the display language"));
+	}
+}
+
+registerAction2(ToggleTextDirectionAction);
